@@ -26,6 +26,49 @@
 #define A5XELTE_MARKER_PA             0x8ffff100
 /* S-Boot starts on the Cortex-A53 "Apollo" cluster, Aff1 = 1. */
 #define A5XELTE_BOOT_MPIDR            0x100
+#elif defined(ARM64_BOARD_CONFIG_A01CORE)
+/*
+ * Galaxy A01 Core (SM-A013F/G/M): MediaTek MT6739, 4x Cortex-A53 (ARMv8.0,
+ * no 16 KiB granule), GIC-500, 13 MHz architected timer, eMMC on MSDC0.
+ * Reuses the Cortex-A53 / 4 KiB / Samsung pieces of the A5XELTE port and
