diff --git a/bsd/dev/a01core_power.c b/bsd/dev/a01core_power.c
new file mode 100644
index 0000000..b50fc5c
--- /dev/null
+++ b/bsd/dev/a01core_power.c
@@ -0,0 +1,268 @@
+/*
+ * Galaxy A01 Core (MT6739 + MT6357 PMIC): battery voltage, charger detect and the
+ * vibration motor, all through the PMIC wrapper (pwrap WACS2).
+ *
+ * Register facts, from the SM-A013 GPL kernel (A013GXXU4AVF4):
+ *   pwrap WACS2 CMD/RDATA/VLDCLR 0xc20/0xc24/0xc28 (pwrap_hal_v1.c, MT6357 build):
+ *     CMD = write << 31 | (adr >> 1) << 16 | wdata; RDATA [15:0] data, [18:16] FSM,
+ *     [21] INIT_DONE. FSM 0 idle, 6 wait-for-valid-clear.
+ *   MT6357 (include/linux/mfd/mt6357/registers.h):
+ *     TOPSTATUS 0x24: bit 2 CHRDET_DEB (charger present).
+ *     AUXADC_RQST0 0x110e bit 0 requests BATADC; AUXADC_ADC0 0x1088: [14:0] value,
+ *     [15] ready (drivers/iio/adc/mt635x-auxadc.c, 15-bit, VOLT_FULL 1800 mV);
+ *     BATSNS ratio 3/1 (arch/arm/boot/dts/mt6357.dtsi batadc resistance-ratio).
+ *     LDO_VIBR_CON0 0x1b08 bit 0 RG_LDO_VIBR_EN (drivers/misc/mediatek/vibrator/mt6739:
+ *     the stock driver only toggles this bit, it does not touch VIBR_VOSEL).
+ *
+ * The A01 Core's real fuel gauge is the Samsung S2MU005 on I2C; until an MT6739 I2C
+ * driver exists, the battery level is estimated from the PMIC's battery voltage.
+ *
+ * Boot-args: a01vib=N pulses the motor for N ms at boot (validation); a01power=0 off.
+ */
+#if defined(ARM64_BOARD_CONFIG_A01CORE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void delay(int usec);
+
+int a01core_power_init(void);
+int a01core_batt_read(unsigned *mv, int *charger);
+void a01core_vibrate(int on);
+void a01core_vibrate_ms(unsigned ms);
+void a01core_power_probe(void);
+int a01core_pmic_read(uint32_t adr, uint16_t *val);
+
+#define PWRAP_PA             0x1000d000u
+#define PWRAP_WACS2_CMD      0xc20u
+#define PWRAP_WACS2_RDATA    0xc24u
+#define PWRAP_WACS2_VLDCLR   0xc28u
+#define WACS_FSM(v)          (((v) >> 16) & 7u)
+#define WACS_INIT_DONE(v)    (((v) >> 21) & 1u)
+#define WACS_FSM_IDLE        0u
+#define WACS_FSM_WFVLDCLR    6u
+
+#define MT6357_HWCID         0x0008u
+#define MT6357_TOPSTATUS     0x0024u
+#define TOP_CHRDET           (1u << 2)
+#define MT6357_AUXADC_ADC0   0x1088u
+#define MT6357_AUXADC_RQST0  0x110eu
+#define AUXADC_RDY           (1u << 15)
+#define MT6357_LDO_VIBR_CON0 0x1b08u
+#define VIBR_EN              (1u << 0)
+
+static vm_offset_t g_pwrap;
+static int g_ok;
+static LCK_GRP_DECLARE(a01_power_grp, "a01core_power");
+static LCK_MTX_DECLARE(a01_power_lock, &a01_power_grp);
+
+static uint32_t
+prd(uint32_t o)
+{
+	uint32_t v = *(volatile uint32_t *)(g_pwrap + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+pwr(uint32_t o, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(g_pwrap + o) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static int
+wait_fsm(uint32_t want, uint32_t *last)
+{
+	for (unsigned i = 0; i < 10000; i++) {
+		*last = prd(PWRAP_WACS2_RDATA);
+		if (WACS_FSM(*last) == want) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+wait_idle(void)
+{
+	uint32_t r;
+	if (wait_fsm(WACS_FSM_IDLE, &r) == 0) {
+		return 0;
+	}
+	if (WACS_FSM(r) == WACS_FSM_WFVLDCLR) {   /* a read nobody acknowledged */
+		pwr(PWRAP_WACS2_VLDCLR, 1);
+		return wait_fsm(WACS_FSM_IDLE, &r);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+pmic_read(uint32_t adr, uint16_t *val)
+{
+	uint32_t r;
+	if (wait_idle()) {
+		return ETIMEDOUT;
+	}
+	pwr(PWRAP_WACS2_CMD, (adr >> 1) << 16);
+	if (wait_fsm(WACS_FSM_WFVLDCLR, &r)) {
+		return ETIMEDOUT;
+	}
+	*val = (uint16_t)(r & 0xffffu);
+	pwr(PWRAP_WACS2_VLDCLR, 1);
+	return 0;
+}
+
+static int
+pmic_write(uint32_t adr, uint16_t val)
+{
+	if (wait_idle()) {
+		return ETIMEDOUT;
+	}
+	pwr(PWRAP_WACS2_CMD, (1u << 31) | ((adr >> 1) << 16) | val);
+	return wait_idle();
+}
+
+int
+a01core_power_init(void)
+{
+	lck_mtx_lock(&a01_power_lock);
+	if (!g_ok) {
+		if (!g_pwrap) {
+			g_pwrap = ml_io_map(PWRAP_PA, 0x1000);
+		}
+		uint16_t cid = 0;
+		if (g_pwrap && WACS_INIT_DONE(prd(PWRAP_WACS2_RDATA)) &&
+		    pmic_read(MT6357_HWCID, &cid) == 0 && (cid >> 8) == 0x57) {
+			g_ok = 1;
+		}
+		printf("A01CORE POWER: pwrap %s, PMIC id %#x%s\n", g_pwrap ? "mapped" : "MAP FAILED",
+		    cid, g_ok ? "" : " (not MT6357: disabled)");
+	}
+	lck_mtx_unlock(&a01_power_lock);
+	return g_ok ? 0 : ENODEV;
+}
+
+/* Locked PMIC read for the other A01 Core drivers (keys): one WACS2 user at a time. */
+int
+a01core_pmic_read(uint32_t adr, uint16_t *val)
+{
+	if (!g_ok && a01core_power_init() != 0) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&a01_power_lock);
+	int error = pmic_read(adr, val);
+	lck_mtx_unlock(&a01_power_lock);
+	return error;
+}
+
+/* Battery voltage in mV (BATSNS, 3:1 divider) and charger presence. */
+int
+a01core_batt_read(unsigned *mv, int *charger)
+{
+	if (!g_ok) {
+		return ENODEV;
+	}
+	int error = 0;
+	uint16_t v = 0, top = 0;
+	lck_mtx_lock(&a01_power_lock);
+	error = pmic_write(MT6357_AUXADC_RQST0, 1u << 0);
+	for (unsigned i = 0; !error && i < 200; i++) {
+		error = pmic_read(MT6357_AUXADC_ADC0, &v);
+		if (!error && (v & AUXADC_RDY)) {
+			break;
+		}
+		delay(50);
+	}
+	if (!error && !(v & AUXADC_RDY)) {
+		error = ETIMEDOUT;
+	}
+	if (!error) {
+		error = pmic_read(MT6357_TOPSTATUS, &top);
+	}
+	lck_mtx_unlock(&a01_power_lock);
+	if (error) {
+		return error;
+	}
+	*mv = (unsigned)(((uint32_t)(v & 0x7fffu) * 3u * 1800u) >> 15);
+	*charger = (top & TOP_CHRDET) != 0;
+	return 0;
+}
+
+void
+a01core_vibrate(int on)
+{
+	if (!g_ok) {
+		return;
+	}
+	uint16_t c;
+	lck_mtx_lock(&a01_power_lock);
+	if (pmic_read(MT6357_LDO_VIBR_CON0, &c) == 0) {
+		c = on ? (uint16_t)(c | VIBR_EN) : (uint16_t)(c & ~VIBR_EN);
+		(void)pmic_write(MT6357_LDO_VIBR_CON0, c);
+	}
+	lck_mtx_unlock(&a01_power_lock);
+}
+
+static int vib_evt;
+
+static void
+vib_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&vib_evt, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Blocking pulse; call from a thread that may sleep. */
+void
+a01core_vibrate_ms(unsigned ms)
+{
+	a01core_vibrate(1);
+	vib_sleep(MIN(ms, 5000u));
+	a01core_vibrate(0);
+}
+
+static void
+power_probe_thread(void *arg, __unused wait_result_t wres)
+{
+	unsigned pulse = (unsigned)(uintptr_t)arg;
+	unsigned mv;
+	int charger;
+	if (pulse) {
+		printf("A01CORE POWER: vibration test %u ms\n", pulse);
+		a01core_vibrate_ms(pulse);
+	}
+	if (a01core_batt_read(&mv, &charger) == 0) {
+		printf("A01CORE POWER: battery %u mV, charger %s\n", mv, charger ? "present" : "absent");
+	} else {
+		printf("A01CORE POWER: battery ADC read failed\n");
+	}
+}
+
+void
+a01core_power_probe(void)
+{
+	int enabled = 1;
+	unsigned pulse = 0;
+	(void)PE_parse_boot_argn("a01power", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("a01vib", &pulse, sizeof(pulse));
+	if (!enabled || a01core_power_init() != 0) {
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(power_probe_thread, (void *)(uintptr_t)pulse, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_A01CORE */
