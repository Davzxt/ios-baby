 	}
 	publish(percent, mv, ma, charging, charging, charging, false, true, true);
 }
+#elif defined(ARM64_BOARD_CONFIG_A01CORE)
+void
+SweetBattery::poll(void)
+{
+	/* Voltage-derived estimate (no S2MU005 fuel gauge yet): unloaded OCV curve,
+	 * reads high while charging. No current measurement. */
+	unsigned mv = 0;
+	int charger = 0;
+	if (!fReal || a01core_batt_read(&mv, &charger) != 0 || mv < 2500 || mv > 4600) {
+		publish(100, 0, 0, true, true, false, false, false, false);
+		return;
+	}
+	unsigned percent = estimatePercent(mv);
+	bool external = charger != 0;
+	publish(percent, mv, 0, external, external, external && percent < 100,
+	    external && percent >= 100, true, false);
+}
 #else
 void
 SweetBattery::poll(void)
@@ -303,6 +329,10 @@ SweetBattery::start(IOService *provider)
 #if defined(ARM64_BOARD_CONFIG_HEROLTE)
 	/* Default on; herofg=0 keeps the static fallback. */
 	fReal = herolte_fg_init() == 0;
+#elif defined(ARM64_BOARD_CONFIG_A01CORE)
+	int real = 1;
