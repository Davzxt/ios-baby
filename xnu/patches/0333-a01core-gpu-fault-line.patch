From e3adfcf9c82a7be6fb5279be56759f6ecce5b4f6 Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Mon, 2 Nov 2026 22:06:22 -0300
Subject: [PATCH] 0333 a01core: show the first GPU page fault (DM, R/W,
 address, requester) above the code line

---
 bsd/dev/a01core_drop.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/a01core_drop.c b/bsd/dev/a01core_drop.c
index 14fcac5..3e40d06 100644
--- a/bsd/dev/a01core_drop.c
+++ b/bsd/dev/a01core_drop.c
@@ -264,7 +264,8 @@ adrop_show(const char *path, vfs_context_t ctx)
  * for up to 10 minutes; the boot-arg a5fb_noconsole hides it once the UI is up, the GPU_DIAG
  * package keeps the console.
  */
-extern void a01pvr_gpu_code(char *buf);   /* gpu/ddk-1.11/env/xnu/pvr_xnu_entry.c */
+extern void a01pvr_gpu_code(char *buf);
+extern void a01pvr_gpu_fault(char *buf, unsigned size);   /* gpu/ddk-1.11/env/xnu/pvr_xnu_entry.c */
 static char adrop_watch_seen[160];
 static int adrop_watch_chan;
 
@@ -318,7 +319,13 @@ adrop_watch_thread(__unused void *arg, __unused wait_result_t wr)
 		 */
 		if ((i & 1) == 1) {
 			char code[8];
+			char fault[48];
 			a01pvr_gpu_code(code);
+			a01pvr_gpu_fault(fault, sizeof(fault));
+			if (fault[0] != '-') {
+				/* first GPU page fault: DM, R/W, GPU address, requester */
+				printf("A01 >>> FALHA: %s <<<\n", fault);
+			}
 			printf("A01 >>> CODIGO: %s-%c <<<\n", code, result);
 		}
 	}
-- 
