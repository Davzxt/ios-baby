From 03e63bdf782ea3d6aa223d485a79f0f88f36259a Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Sun, 1 Nov 2026 18:22:02 -0300
Subject: [PATCH] 0317 a01core: MIPS page table 32 KiB-aligned in physical
 memory

---
 bsd/dev/a01core_gpu.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/bsd/dev/a01core_gpu.c b/bsd/dev/a01core_gpu.c
index df9cd16..111713f 100644
--- a/bsd/dev/a01core_gpu.c
+++ b/bsd/dev/a01core_gpu.c
@@ -201,7 +201,7 @@ gpu_fw_boot(vm_offset_t rgx)
 	memcpy(s, info + hlen, n * esz);
 
 	vm_offset_t va = 0;
-	if (kmem_alloc_contig(kernel_map, &va, FW_TOTAL, 0xFFFF, 0, 0,
+	if (kmem_alloc_contig(kernel_map, &va, FW_TOTAL, 0, 0, 0xF /* 64 KiB physical alignment: PT needs 32 KiB */,
 	    KMA_NOPAGEWAIT | KMA_KOBJECT | KMA_PERMANENT | KMA_ZERO, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS) {
 		printf("A01CORE GPU FW: no contiguous memory\n");
 		return;
-- 
