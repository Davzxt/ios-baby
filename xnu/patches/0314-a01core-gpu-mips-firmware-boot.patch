From 379d89a7d299c924e138aabc269a7cbf54212c3f Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Sun, 1 Nov 2026 17:15:37 -0300
Subject: [PATCH] 0314 a01core: load rgx.fw and start the GE8100 MIPS firmware
 processor

---
 bsd/dev/a01core_gpu.c | 191 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 191 insertions(+)

diff --git a/bsd/dev/a01core_gpu.c b/bsd/dev/a01core_gpu.c
index 49562c2..be09cbc 100644
--- a/bsd/dev/a01core_gpu.c
+++ b/bsd/dev/a01core_gpu.c
@@ -106,6 +106,194 @@ power_on(vm_offset_t spm, uint32_t con, uint32_t sta)
 	return wait_bits(spm, con, SRAM_PDN_ACK, 0) ? 2 : 0;
 }
 
+/*
+ * Step 2: load the vendor MIPS firmware (vendor/firmware/rgx.fw, passed in the payload as
+ * /chosen/memory-map "GPUFirmware") and start the GPU's MIPS core, following the DDK
+ * m1.11ED5425693: rgxfwimageutils.c (ProcessELFCommandStream, MIPS boot config),
+ * rgxsrvinit.c (RGXAcquireMipsBootldrData), rgxstartstop.c (RGXStart, RGXInitMipsProcWrapper),
+ * rgxmipsmmuinit.c (4 KiB PTE format), include/rgx_mips.h, rgx_fw_info.h.
+ * Only the bootloader stage is checked (BOOT_DATA + 0x400, written by the firmware);
+ * the host init structures (RGXFWIF_INIT) are not built yet, so the main firmware is
+ * expected to stop after boot.
+ */
+#include <vm/vm_kern.h>
+#include <libkern/OSByteOrder.h>
+extern void flush_dcache(vm_offset_t addr, unsigned count, int phys);
+extern uint64_t kvtophys(vm_offset_t va);
+#include <pexpert/device_tree.h>
+
+#define RGX_CR_SOFT_RESET            0x0100u
+#define SOFT_RESET_MASKFULL          0x00E7FFFFFFFFFC1Dull
+#define SOFT_RESET_RASCALDUSTS       0x000001F8E0000000ull   /* RASCAL_CORE | DUST_A..H_CORE */
+#define SOFT_RESET_GARTEN            0x0000000100000000ull
+#define RGX_CR_SYS_BUS_SECURE        0xA100u
+#define RGX_CR_MIPS_WRAPPER_CONFIG   0x0810u
+#define WRAPPER_BOOT_ISA_MICROMIPS   0x10000ull
+#define RGX_CR_MIPS_REMAP1_CONFIG1   0x0818u                 /* REMAPn: +0x10 per n, CONFIG2 = CONFIG1 + 8 */
+#define REMAP_MODE_ENABLE            1ull
+#define REMAP_ADDR_OUT_MASK          0x000000FFFFFFF000ull
+#define REMAP_LOG2_SEG_4K            12ull
+#define RGX_CR_MTS_GARTEN_WRAPPER    0x0B50u
+#define RGX_CR_MIPS_DEBUG_CONFIG     0x08C8u
+#define RGX_CR_MIPS_WRAPPER_IRQ_STA  0x08A8u
+#define RGX_CR_MIPS_EXCEPTION_STATUS 0x08D0u
+
+/* rgx_mips.h */
+#define MIPS_BOOT_IN   0x1FC00000ull
+#define MIPS_DATA_IN   0x1FC01000ull
+#define MIPS_CODE_IN   0x1FC02000ull
+#define MIPS_HEAP_VA   0xC0000000u
+#define PTE_PFN_SHIFT  6
+#define PTE_UNCACHED   (2u << 3)
+#define PTE_DVG        0x7u                                  /* dirty | valid | global */
+#define BOOT_STAGE_OFF 0x400u
+
+/* rgx_fw_info.h section ids */
+enum { S_MIPS_CODE = 4, S_MIPS_EXC, S_MIPS_BOOT_CODE, S_MIPS_PRIV_DATA, S_MIPS_BOOT_DATA, S_MIPS_STACK };
+struct fw_sect { uint32_t id, type, base, max, alloc, off; };
+
+#define FW_CODE_OFF  0x00000u     /* code allocation (type 1) */
+#define FW_DATA_OFF  0x20000u     /* data allocation (type 2) */
+#define FW_PT_OFF    0x28000u     /* MIPS page table, 32 KiB (rgx_mips.h LOG2_PAGETABLE_PAGE_SIZE 15) */
+#define FW_TOTAL     0x30000u
+
+static void
+wr64(vm_offset_t b, uint32_t o, uint64_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint64_t *)(b + o) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static uint64_t
+rd64(vm_offset_t b, uint32_t o)
+{
+	uint64_t v = *(volatile uint64_t *)(b + o);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gpu_fw_boot(vm_offset_t rgx)
+{
+	DTEntry node;
+	const uint64_t *reg;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "GPUFirmware", (void const **)&reg, &size) != kSuccess || size < 16) {
+		printf("A01CORE GPU FW: no rgx.fw in the payload (mkpayload.py --blob GPUFirmware=rgx.fw)\n");
+		return;
+	}
+	const uint8_t *fw = (const uint8_t *)ml_static_ptovirt((vm_offset_t)reg[0]);
+	uint64_t len = reg[1];
+	if (!fw || len < 8192 || OSReadLittleInt32(fw, 0) != 0x464c457f) {
+		printf("A01CORE GPU FW: bad image (len %llu)\n", len);
+		return;
+	}
+	/* FW info header in the last 4 KiB: version, header length, entries, entry size */
+	const uint8_t *info = fw + len - 4096;
+	uint32_t hlen = OSReadLittleInt32(info, 4), n = OSReadLittleInt32(info, 8), esz = OSReadLittleInt32(info, 12);
+	if (OSReadLittleInt32(info, 0) != 1 || esz != sizeof(struct fw_sect) || n > 16) {
+		printf("A01CORE GPU FW: bad layout table\n");
+		return;
+	}
+	struct fw_sect s[16];
+	memcpy(s, info + hlen, n * esz);
+
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, FW_TOTAL, 0xFFFF, 0, 0,
+	    KMA_NOPAGEWAIT | KMA_KOBJECT | KMA_PERMANENT | KMA_ZERO, VM_KERN_MEMORY_DIAG) != KERN_SUCCESS) {
+		printf("A01CORE GPU FW: no contiguous memory\n");
+		return;
+	}
+	uint64_t pa = kvtophys(va);
+	uint64_t code_pa = pa + FW_CODE_OFF, data_pa = pa + FW_DATA_OFF, pt_pa = pa + FW_PT_OFF;
+
+	/* ELF PT_LOAD segments into their sections (FindMMUSegment) */
+	uint32_t phoff = OSReadLittleInt32(fw, 0x1c);
+	uint16_t phnum = OSReadLittleInt16(fw, 0x2c);
+	uint64_t boot_off = 0, bdata_off = 0, stack_off = 0, exc_off = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		uint64_t at = (s[i].type == 1 ? FW_CODE_OFF : FW_DATA_OFF) + s[i].off;
+		if (s[i].id == S_MIPS_BOOT_CODE) boot_off = at;
+		if (s[i].id == S_MIPS_BOOT_DATA) bdata_off = at;
+		if (s[i].id == S_MIPS_STACK) stack_off = at;
+		if (s[i].id == S_MIPS_EXC) exc_off = at;
+	}
+	for (uint16_t p = 0; p < phnum; p++) {
+		const uint8_t *ph = fw + phoff + 32u * p;
+		if (OSReadLittleInt32(ph, 0) != 1) continue;
+		uint32_t off = OSReadLittleInt32(ph, 4), v = OSReadLittleInt32(ph, 8);
+		uint32_t fsz = OSReadLittleInt32(ph, 16), msz = OSReadLittleInt32(ph, 20);
+		uint32_t i;
+		for (i = 0; i < n; i++) {
+			if (s[i].type && v >= s[i].base && v + msz <= s[i].base + s[i].max) break;
+		}
+		uint64_t at = (i < n) ? (s[i].type == 1 ? FW_CODE_OFF : FW_DATA_OFF) + s[i].off + (v - s[i].base) : 0;
+		if (i == n || at + msz > (s[i].type == 1 ? FW_DATA_OFF : FW_PT_OFF) || (uint64_t)off + fsz > len) {
+			printf("A01CORE GPU FW: segment %#x (%#x bytes) has no section\n", v, msz);
+			return;
+		}
+		memcpy((void *)(va + at), fw + off, fsz);
+	}
+	if (!boot_off || !bdata_off || !stack_off || !exc_off) {
+		printf("A01CORE GPU FW: layout table lacks MIPS sections\n");
+		return;
+	}
+	/* bootloader config (rgxfwimageutils.c): regs PA, page table PA, stack PA */
+	uint64_t *bc = (uint64_t *)(va + bdata_off);
+	bc[0] = 0x13000000ull;
+	bc[1] = pt_pa;
+	bc[2] = pa + stack_off;
+	bc[3] = 0;
+	/* MIPS page table: FW heap 0xC0000000 = code allocation, data allocation at the data base */
+	uint32_t *pt = (uint32_t *)(va + FW_PT_OFF);
+	uint32_t data_base = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		if (s[i].id == S_MIPS_PRIV_DATA) data_base = s[i].base;
+	}
+	for (uint32_t i = 0; i < (FW_DATA_OFF - FW_CODE_OFF) / 4096; i++) {
+		pt[i] = (uint32_t)(((code_pa >> 12) + i) << PTE_PFN_SHIFT) | PTE_UNCACHED | PTE_DVG;
+	}
+	for (uint32_t i = 0; i < (FW_PT_OFF - FW_DATA_OFF) / 4096; i++) {
+		pt[((data_base - MIPS_HEAP_VA) >> 12) + i] =
+		    (uint32_t)(((data_pa >> 12) + i) << PTE_PFN_SHIFT) | PTE_UNCACHED | PTE_DVG;
+	}
+	flush_dcache(va, FW_TOTAL, FALSE);
+
+	/* RGXStart, MIPS path */
+	wr64(rgx, RGX_CR_SYS_BUS_SECURE, 0);
+	wr64(rgx, RGX_CR_SOFT_RESET, SOFT_RESET_MASKFULL);
+	wr64(rgx, RGX_CR_SOFT_RESET, SOFT_RESET_MASKFULL ^ SOFT_RESET_RASCALDUSTS);
+	(void)rd64(rgx, RGX_CR_SOFT_RESET);
+	wr64(rgx, RGX_CR_SOFT_RESET, SOFT_RESET_GARTEN);
+	wr64(rgx, RGX_CR_MIPS_WRAPPER_CONFIG, (0x13000000ull >> 16) | WRAPPER_BOOT_ISA_MICROMIPS);
+	const uint64_t remap_in[4] = { MIPS_BOOT_IN, MIPS_DATA_IN, MIPS_CODE_IN, 0 };
+	const uint64_t remap_out[4] = { pa + boot_off, pa + bdata_off, pa + exc_off, pa + boot_off };
+	const uint32_t remap_n[4] = { 1, 2, 3, 5 };     /* REMAP5: BRN 63553 (GE8100), MIPS PA 0 -> boot page */
+	for (unsigned i = 0; i < 4; i++) {
+		uint32_t c1 = RGX_CR_MIPS_REMAP1_CONFIG1 + 0x10u * (remap_n[i] - 1);
+		wr64(rgx, c1, remap_in[i] | REMAP_MODE_ENABLE);
+		wr64(rgx, c1 + 8, (remap_out[i] & REMAP_ADDR_OUT_MASK) | REMAP_LOG2_SEG_4K);
+	}
+	wr64(rgx, RGX_CR_MTS_GARTEN_WRAPPER, 0);
+	*(volatile uint32_t *)(rgx + RGX_CR_MIPS_DEBUG_CONFIG) = 0;
+	delay(10);
+	wr64(rgx, RGX_CR_SOFT_RESET, 0);          /* releases the MIPS: it starts at 0xBFC00000 */
+	(void)rd64(rgx, RGX_CR_SOFT_RESET);
+
+	uint32_t stage = 0;
+	for (unsigned t = 0; t < 200; t++) {           /* up to 2 s */
+		delay(10000);
+		flush_dcache(va + bdata_off, 4096, FALSE);
+		stage = *(volatile uint32_t *)(va + bdata_off + BOOT_STAGE_OFF);
+		if (stage) break;
+	}
+	printf("A01CORE GPU FW: loaded %llu bytes at %#llx; boot stage %#x, mips exc %#llx irq %#llx%s\n",
+	    len, pa, stage, rd64(rgx, RGX_CR_MIPS_EXCEPTION_STATUS), rd64(rgx, RGX_CR_MIPS_WRAPPER_IRQ_STA),
+	    stage ? " -> FIRMWARE RUNNING" : " -> firmware did not report");
+}
+
 void
 a01core_gpu_probe(void)
 {
@@ -149,5 +337,8 @@ a01core_gpu_probe(void)
 	unsigned b = hi >> 16, v = hi & 0xffffu, n = lo >> 16, c = lo & 0xffffu;
 	printf("A01CORE GPU: core id %#x, BVNC %u.%u.%u.%u%s\n", rd(rgx, RGX_CORE_ID), b, v, n, c,
 	    (b == 22 && v == 49 && n == 21 && c == 16) ? " (GE8100) OK" : " (unexpected)");
+	if (b == 22 && v == 49 && n == 21 && c == 16) {
+		gpu_fw_boot(rgx);
+	}
 }
 #endif /* ARM64_BOARD_CONFIG_A01CORE */
-- 
2.55.0.windows.5

