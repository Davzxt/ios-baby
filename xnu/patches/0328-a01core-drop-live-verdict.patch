From 7333996819a0c6b42039082c8f0f21e812729e46 Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Mon, 2 Nov 2026 13:42:42 -0300
Subject: [PATCH] 0328 a01core: print the GPU test's verdict line live during
 the boot (one boot instead of two)

---
 bsd/dev/a01core_drop.c | 55 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/bsd/dev/a01core_drop.c b/bsd/dev/a01core_drop.c
index a70beba..acc6c5b 100644
--- a/bsd/dev/a01core_drop.c
+++ b/bsd/dev/a01core_drop.c
@@ -19,6 +19,7 @@
 #include <sys/fcntl.h>
 #include <sys/stat.h>
 #include <sys/proc.h>
+#include <sys/kernel.h>
 #include <string.h>
 #include <sys/vnode_internal.h>
 #include <sys/namei.h>
@@ -257,6 +258,55 @@ adrop_show(const char *path, vfs_context_t ctx)
 	return 1;
 }
 
+/*
+ * One boot instead of two: the GPU test (the root's autorun) keeps a verdict line at the top of
+ * its output ("A01METAL: >>> ..."). Print it on the console whenever it changes during this boot,
+ * for up to 10 minutes; the boot-arg a5fb_noconsole hides it once the UI is up, the GPU_DIAG
+ * package keeps the console.
+ */
+static char adrop_watch_seen[160];
+static int adrop_watch_chan;
+
+static int
+adrop_first_line(const char *path, char *line, size_t size, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	int resid = 0;
+	if (vnode_open(path, FREAD, 0, 0, &vp, ctx) != 0) {
+		return 0;
+	}
+	int ok = vn_rdwr(UIO_READ, vp, (caddr_t)line, (int)size - 1, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx)) == 0;
+	vnode_close(vp, FREAD, ctx);
+	if (!ok) {
+		return 0;
+	}
+	line[size - 1 - resid] = '\0';
+	char *nl = strchr(line, '\n');
+	if (nl != NULL) {
+		*nl = '\0';
+	}
+	return strncmp(line, "A01METAL: >>>", 13) == 0;
+}
+
+static void
+adrop_watch_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	char line[sizeof(adrop_watch_seen)];
+	for (unsigned i = 0; i < 120; i++) {           /* every 5 s for 10 minutes */
+		(void)tsleep((caddr_t)&adrop_watch_chan, PRIBIO, "a01watch", 5 * hz);
+		if (adrop_first_line("/private/var/herolte/autorun.out", line, sizeof(line), ctx) &&
+		    strcmp(line, adrop_watch_seen) != 0) {
+			strlcpy(adrop_watch_seen, line, sizeof(adrop_watch_seen));
+			printf("%s (agora, %u s)\n", line, (i + 1) * 5);
+			if (strstr(line, "RESULTADO") != NULL) {
+				return;
+			}
+		}
+	}
+}
+
 /* launchd remounts the root read-write itself: wait for it, then install */
 static void
 adrop_thread(__unused void *arg, __unused wait_result_t wr)
@@ -287,11 +337,16 @@ a01core_drop_apply(void)
 		vfs_context_t ctx = vfs_context_kernel();
 		int shown = adrop_show("/private/var/a01/drop.txt", ctx);
 		shown += adrop_show("/private/var/herolte/autorun.out", ctx);
+		/* last boot's verdict: the watcher prints only lines that differ from it */
+		(void)adrop_first_line("/private/var/herolte/autorun.out", adrop_watch_seen, sizeof(adrop_watch_seen), ctx);
 		if (shown) {
 			printf("A01CORE REPORT: holding 15 s\n");
 			IOSleep(15000);
 		}
 	}
+	if (on && kernel_thread_start(adrop_watch_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 	if (!on || SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
 	    SecureDTGetProperty(node, "A01Drop", (void const **)&reg, &size) != kSuccess || size < 16 ||
 	    reg[1] < ADROP_DATA) {
-- 
2.55.0.windows.5

