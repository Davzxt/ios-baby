From e8cc04f62900dc99fc857414e3b9a323c311e0f6 Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Sun, 1 Nov 2026 20:55:27 -0300
Subject: [PATCH] 0321 a01core: A01CoreGPU boot self-test (opens one DDK
 connection: firmware load and boot)

---
 iokit/Kernel/arm/A01CoreGPU.cpp | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/iokit/Kernel/arm/A01CoreGPU.cpp b/iokit/Kernel/arm/A01CoreGPU.cpp
index ec2a4d5..912130a 100644
--- a/iokit/Kernel/arm/A01CoreGPU.cpp
+++ b/iokit/Kernel/arm/A01CoreGPU.cpp
@@ -19,6 +19,7 @@
 #include <IOKit/IOLib.h>
 #include <IOKit/IOBufferMemoryDescriptor.h>
 #include <kern/task.h>
+#include <kern/thread.h>
 
 extern "C" {
 int a01pvr_driver_init(void);
@@ -114,6 +115,20 @@ a01gpu_buf_unmap_user(struct a01gpu_buf *b, uint64_t uaddr)
 	}
 }
 
+static void
+a01pvr_selftest(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	void *conn = NULL;
+	IOLog("A01CORE PVR: self-test: opening a connection (firmware load and boot)\n");
+	int e = a01pvr_open(&conn);
+	IOLog("A01CORE PVR: self-test: open %s (%d)\n", e == 0 ? "OK, GPU initialised by the DDK" : "FAILED", e);
+	if (conn != NULL) {
+		a01pvr_close(conn);
+	}
+	IOSleep(15000);   /* time to photograph the console */
+}
+
 /* ---- the service ---------------------------------------------------------------------------- */
 class A01CoreGPU : public IOService {
 	OSDeclareDefaultStructors(A01CoreGPU);
@@ -142,6 +157,12 @@ A01CoreGPU::start(IOService *provider)
 	setProperty("GPU", "PowerVR GE8100 (BVNC 22.49.21.16), DDK 1.11");
 	registerService();
 	IOLog("A01CORE PVR: A01CoreGPU registered\n");
+	/* Self-test: open one connection now, so the DDK loads and boots the firmware at boot
+	 * (PVRSRVDeviceInitialise) instead of at the first app. Off the boot thread. */
+	thread_t th;
+	if (kernel_thread_start(a01pvr_selftest, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
 	return true;
 }
 
