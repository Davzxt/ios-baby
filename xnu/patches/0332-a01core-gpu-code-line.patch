From a94cd450d0eb8c8896a462ba32bf3dc0c35e72fb Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Mon, 2 Nov 2026 21:44:40 -0300
Subject: [PATCH] 0332 a01core: GPU code line every 10 s (4 GPU letters + test
 result) for typing back instead of photos

---
 bsd/dev/a01core_drop.c | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/a01core_drop.c b/bsd/dev/a01core_drop.c
index dc95082..14fcac5 100644
--- a/bsd/dev/a01core_drop.c
+++ b/bsd/dev/a01core_drop.c
@@ -264,6 +264,7 @@ adrop_show(const char *path, vfs_context_t ctx)
  * for up to 10 minutes; the boot-arg a5fb_noconsole hides it once the UI is up, the GPU_DIAG
  * package keeps the console.
  */
+extern void a01pvr_gpu_code(char *buf);   /* gpu/ddk-1.11/env/xnu/pvr_xnu_entry.c */
 static char adrop_watch_seen[160];
 static int adrop_watch_chan;
 
@@ -294,16 +295,32 @@ adrop_watch_thread(__unused void *arg, __unused wait_result_t wr)
 {
 	vfs_context_t ctx = vfs_context_kernel();
 	char line[sizeof(adrop_watch_seen)];
-	for (unsigned i = 0; i < 120; i++) {           /* every 5 s for 10 minutes */
+	char result = '-';
+	for (unsigned i = 0; i < 180; i++) {           /* every 5 s for 15 minutes */
 		(void)tsleep((caddr_t)&adrop_watch_chan, PRIBIO, "a01watch", 5 * hz);
 		if (adrop_first_line("/private/var/herolte/autorun.out", line, sizeof(line), ctx) &&
 		    strcmp(line, adrop_watch_seen) != 0) {
 			strlcpy(adrop_watch_seen, line, sizeof(adrop_watch_seen));
 			printf("%s (agora, %u s)\n", line, (i + 1) * 5);
-			if (strnstr(line, "RESULTADO", sizeof(line)) != NULL) {
-				return;
+			if (strnstr(line, "FUNCIONOU", sizeof(line)) != NULL) {
+				result = '1';
+			} else if (strnstr(line, "RESULTADO", sizeof(line)) != NULL) {
+				result = '0';
+			} else if (strnstr(line, "PAROU", sizeof(line)) != NULL ||
+			    strnstr(line, "TRAVADO", sizeof(line)) != NULL) {
+				result = 'P';
 			}
 		}
+		/*
+		 * The user can no longer photograph the screen: every 10 s one short line, always the last
+		 * on screen, that can be typed back: 4 GPU letters (pvr_xnu_entry.c a01pvr_gpu_code) and the
+		 * test result (1 worked, 0 failed, P stopped/hung, - not yet).
+		 */
+		if ((i & 1) == 1) {
+			char code[8];
+			a01pvr_gpu_code(code);
+			printf("A01 >>> CODIGO: %s-%c <<<\n", code, result);
+		}
 	}
 }
 
-- 
