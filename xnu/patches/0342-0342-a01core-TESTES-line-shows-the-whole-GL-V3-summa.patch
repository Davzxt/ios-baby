From ac2c5a1a023beb5f10d7c6d1c914d67bc016d576 Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Tue, 3 Nov 2026 17:51:53 -0300
Subject: [PATCH] 0342 a01core: TESTES line shows the whole GL/V3 summary (and
 LF line endings again)

---
 bsd/dev/a01core_drop.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/a01core_drop.c b/bsd/dev/a01core_drop.c
index 707f994..dfdf95f 100644
--- a/bsd/dev/a01core_drop.c
+++ b/bsd/dev/a01core_drop.c
@@ -451,13 +451,13 @@ adrop_watch_thread(__unused void *arg, __unused wait_result_t wr)
 				/* the test's GL summary, "GL 1234567" between quotes in its first line (+ ok, - wrong, ? running) */
 				const char *q = strnstr(adrop_watch_seen, "\"GL ", sizeof(adrop_watch_seen));
 				if (q != NULL) {
-					char gl[12];
+					char gl[48];
 					strlcpy(gl, q + 4, sizeof(gl));
 					char *e = strnstr(gl, "\"", sizeof(gl));
 					if (e != NULL) {
 						*e = '\0';
 					}
-					printf("A01 >>> TESTES GL1-7: %s <<<\n", gl);
+					printf("A01 >>> TESTES: GL %s <<<\n", gl);
 				}
 			}
 			printf("A01 >>> CODIGO: %s-%c-%c%c%c%c <<<\n", code, result, adrop_fill_letter(),
