From 8cde15d7d23962128a16decfe53194285cdd9914 Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Tue, 3 Nov 2026 00:06:02 -0300
Subject: [PATCH] 0337 a01core: quiet console matches panic( not 'Panic'
 (gPanicBase warning); touch always reports its state

---
 bsd/dev/a01core_touch.c        | 2 ++
 osfmk/console/serial_console.c | 2 +-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/a01core_touch.c b/bsd/dev/a01core_touch.c
index c1e4ed7..eede68e 100644
--- a/bsd/dev/a01core_touch.c
+++ b/bsd/dev/a01core_touch.c
@@ -755,6 +755,7 @@ nvt_chip_id(void)
 			return 0;
 		}
 		if (retry == 4) {
+			TOUCH_SAY("NT36525 nao respondeu (id %02x%02x%02x%02x%02x%02x)", id[0], id[1], id[2], id[3], id[4], id[5]);
 			LOG("NT36525 trim id %02x %02x %02x %02x %02x %02x: not Novatek", id[0], id[1], id[2],
 			    id[3], id[4], id[5]);
 		}
@@ -959,6 +960,7 @@ nvt_report(const uint8_t *pd)
 static void
 nvt_run(void)
 {
+	TOUCH_SAY("procurando o controlador NT36525B");
 	nvt_tx = kalloc_data(NVT_XFER + 8, Z_WAITOK | Z_ZERO);
 	nvt_rx = kalloc_data(256, Z_WAITOK | Z_ZERO);
 	if (!nvt_tx || !nvt_rx) {
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index 456be46..f582a1f 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -297,7 +297,7 @@ static bool
 a01_keep_line(const char *s, int n)
 {
 	static const char *const keys[] = {
-		"A01 >>>", "anic", "Debugger",   /* 0335: only the typeable status lines and panics */
+		"A01 >>>", "panic(", "Debugger",   /* 0335: only the typeable status lines and panics */
 	};
 	for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
 		if (strnstr(s, keys[i], (size_t)n) != NULL) {
-- 
