+	    ok ? " (GE8100) OK" : " (unexpected)");
+	a01_gpu_powered = ok;
+	return ok ? 0 : 4;
+}
+
+/* vendor/firmware/rgx.fw (DDK 1.11@5425693) from the payload: mkpayload.py --blob GPUFirmware= */
+const void *
+a01core_gpu_firmware(size_t *len)
+{
+	DTEntry node;
+	const uint64_t *reg;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "GPUFirmware", (void const **)&reg, &size) != kSuccess || size < 16) {
+		printf("A01CORE GPU: no rgx.fw in the payload\n");
+		return NULL;
+	}
+	*len = (size_t)reg[1];
+	return (const void *)ml_static_ptovirt((vm_offset_t)reg[0]);
+}
+
+/* boot-arg a01gpu: 0 off, 1 bring-up test (hand loader + ping, 0314-0318), 2 full DDK driver */
+int
+a01core_gpu_mode(void)
+{
+	int mode = 0;
+	(void)PE_parse_boot_argn("a01gpu", &mode, sizeof(mode));
+	return mode;
+}
+
+void
+a01core_gpu_probe(void)
+{
+	int mode = a01core_gpu_mode();
+	if (!mode) {
+		printf("A01CORE GPU: off (a01gpu=1 bring-up test, a01gpu=2 DDK driver)\n");
+		return;
+	}
+	if (a01core_gpu_power_on()) {
+		return;
+	}
+	if (mode == 1) {
+		gpu_fw_boot(ml_io_map(RGX_PA, 0x10000));
+	} else {
+		printf("A01CORE GPU: DDK 1.11 driver takes over (A01CoreGPU)\n");
 	}
 }
 #endif /* ARM64_BOARD_CONFIG_A01CORE */
diff --git a/iokit/Kernel/arm/A01CoreGPU.cpp b/iokit/Kernel/arm/A01CoreGPU.cpp
new file mode 100644
index 0000000..ec2a4d5
--- /dev/null
+++ b/iokit/Kernel/arm/A01CoreGPU.cpp
@@ -0,0 +1,228 @@
+/*
+ * Galaxy A01 Core (MT6739) PowerVR GE8100: IOKit front end of the DDK 1.11 kernel driver
+ * (bsd/a01_pvr, from gpu/ddk-1.11). Boot-arg a01gpu=2.
+ *
+ * A01CoreGPU            publishes the service and starts the DDK (a01pvr_driver_init).
+ * A01CoreGPUUserClient  one DDK connection per opener:
+ *   selector 0  bridge call: scalars {group, function, in ptr, in size, out ptr, out size}
+ *               -> scalar {PVRSRV_ERROR}; same contract as the Linux PVR_DRM_IOCTL_SRVKM_CMD
+ *   selector 1  map a PMR: scalar {secure PMR handle} -> scalars {PVRSRV_ERROR, user address}
+ *               (the Linux driver does this with mmap(offset = handle))
+ *
+ * GPU memory for the DDK (a01gpu_buf_*): IOBufferMemoryDescriptor below 4 GiB (32-bit GPU bus).
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(ARM64_BOARD_CONFIG_A01CORE)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <kern/task.h>
+
+extern "C" {
+int a01pvr_driver_init(void);
+int a01pvr_open(void **ppvConnection);
+void a01pvr_close(void *pvConnection);
+int a01pvr_bridge(void *pvConnection, uint32_t group, uint32_t func, uint64_t in, uint32_t in_size,
+    uint64_t out, uint32_t out_size);
+int a01pvr_mmap(void *pvConnection, uint64_t pmr_handle, uint64_t *uaddr);
+int a01core_gpu_mode(void);
+int a01core_gpu_power_on(void);
+}
+
+/* ---- GPU-visible memory for the DDK (gpu/ddk-1.11/env/xnu/a01gpu_buf.h) ----------------------- */
+#define A01GPU_MAX_MAPS 4
+struct a01gpu_buf {
+	IOBufferMemoryDescriptor *md;
+	uint64_t size;
+	IOMemoryMap *umaps[A01GPU_MAX_MAPS];
+};
+
+extern "C" struct a01gpu_buf *
+a01gpu_buf_alloc(uint64_t size, int contiguous)
+{
+	struct a01gpu_buf *b = IONewZero(struct a01gpu_buf, 1);
+	if (b == NULL) {
+		return NULL;
+	}
+	b->size = round_page_64(size);
+	IOOptionBits opts = kIODirectionInOut | kIOMemoryKernelUserShared;
+	if (contiguous) {
+		opts |= kIOMemoryPhysicallyContiguous;
+	}
+	/* GE8100: RGX_FEATURE_PHYS_BUS_WIDTH 32 */
+	b->md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, opts, b->size,
+	    0x00000000FFFFF000ULL);
+	if (b->md == NULL || b->md->prepare() != kIOReturnSuccess) {
+		OSSafeReleaseNULL(b->md);
+		IODelete(b, struct a01gpu_buf, 1);
+		return NULL;
+	}
+	return b;
+}
+
+extern "C" void
+a01gpu_buf_free(struct a01gpu_buf *b)
+{
+	if (b == NULL) {
+		return;
+	}
+	for (unsigned i = 0; i < A01GPU_MAX_MAPS; i++) {
+		OSSafeReleaseNULL(b->umaps[i]);
+	}
+	b->md->complete();
+	OSSafeReleaseNULL(b->md);
+	IODelete(b, struct a01gpu_buf, 1);
+}
+
+extern "C" void *a01gpu_buf_kva(struct a01gpu_buf *b) { return b->md->getBytesNoCopy(); }
+extern "C" uint64_t a01gpu_buf_size(struct a01gpu_buf *b) { return b->size; }
+
+extern "C" uint64_t
+a01gpu_buf_phys(struct a01gpu_buf *b, uint64_t offset)
+{
+	IOByteCount len;
+	return b->md->getPhysicalSegment(offset, &len, kIOMemoryMapperNone);
+}
+
+extern "C" int
+a01gpu_buf_map_user(struct a01gpu_buf *b, int cache_mode, uint64_t *uaddr)
+{
+	IOOptionBits cache = cache_mode == 1 ? kIOMapInhibitCache :
+	    cache_mode == 2 ? kIOMapWriteCombineCache : kIOMapDefaultCache;
+	for (unsigned i = 0; i < A01GPU_MAX_MAPS; i++) {
+		if (b->umaps[i] == NULL) {
+			b->umaps[i] = b->md->createMappingInTask(current_task(), 0, kIOMapAnywhere | cache);
+			if (b->umaps[i] == NULL) {
+				return 1;
+			}
+			*uaddr = b->umaps[i]->getAddress();
+			return 0;
+		}
+	}
+	return 2;
+}
+
+extern "C" void
+a01gpu_buf_unmap_user(struct a01gpu_buf *b, uint64_t uaddr)
+{
+	for (unsigned i = 0; i < A01GPU_MAX_MAPS; i++) {
+		if (b->umaps[i] != NULL && b->umaps[i]->getAddress() == uaddr) {
+			OSSafeReleaseNULL(b->umaps[i]);
+		}
+	}
+}
