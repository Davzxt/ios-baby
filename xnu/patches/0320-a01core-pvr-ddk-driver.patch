+/* ---- the service ---------------------------------------------------------------------------- */
+class A01CoreGPU : public IOService {
+	OSDeclareDefaultStructors(A01CoreGPU);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(A01CoreGPU, IOService);
+
+bool
+A01CoreGPU::start(IOService *provider)
+{
+	if (a01core_gpu_mode() != 2 || !IOService::start(provider)) {
+		return false;
+	}
+	if (a01core_gpu_power_on() != 0) {
+		IOLog("A01CORE PVR: GE8100 did not power on, driver not started\n");
+		return false;
+	}
+	int e = a01pvr_driver_init();
+	if (e != 0) {
+		IOLog("A01CORE PVR: DDK driver init failed (%d)\n", e);
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "A01CoreGPUUserClient");
+	setProperty("GPU", "PowerVR GE8100 (BVNC 22.49.21.16), DDK 1.11");
+	registerService();
+	IOLog("A01CORE PVR: A01CoreGPU registered\n");
+	return true;
+}
+
+class A01CoreGPUUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(A01CoreGPUUserClient);
+	void *fConnection;
+	IOLock *fLock;
+public:
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(A01CoreGPUUserClient, IOUserClient);
+
+bool
+A01CoreGPUUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fLock = IOLockAlloc();
+	/* runs in the opener's context: the DDK records its PID for the connection */
+	int e = a01pvr_open(&fConnection);
+	if (e != 0) {
+		IOLog("A01CORE PVR: open failed (%d)\n", e);
+	}
+	return fLock != NULL && e == 0;
+}
+
+IOReturn
+A01CoreGPUUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+A01CoreGPUUserClient::free(void)
+{
+	if (fConnection != NULL) {
+		a01pvr_close(fConnection);
+		fConnection = NULL;
+	}
+	if (fLock != NULL) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+A01CoreGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	switch (selector) {
+	case 0:
+		if (args->scalarInputCount != 6 || args->scalarOutputCount != 1) {
+			return kIOReturnBadArgument;
+		}
+		/* bridge calls run in the caller's thread: copyin/copyout use its address space */
+		args->scalarOutput[0] = (uint64_t)(uint32_t)a01pvr_bridge(fConnection,
+		    (uint32_t)args->scalarInput[0], (uint32_t)args->scalarInput[1],
+		    args->scalarInput[2], (uint32_t)args->scalarInput[3],
+		    args->scalarInput[4], (uint32_t)args->scalarInput[5]);
+		return kIOReturnSuccess;
+	case 1: {
+		if (args->scalarInputCount != 1 || args->scalarOutputCount != 2) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t uaddr = 0;
+		IOLockLock(fLock);
+		args->scalarOutput[0] = (uint64_t)(uint32_t)a01pvr_mmap(fConnection, args->scalarInput[0], &uaddr);
+		IOLockUnlock(fLock);
+		args->scalarOutput[1] = uaddr;
+		return kIOReturnSuccess;
+	}
+	default:
+		return kIOReturnUnsupported;
+	}
+}
