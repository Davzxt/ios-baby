From e3870d8660499005b205f1a2acf6d9be0349eef3 Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Mon, 2 Nov 2026 09:15:08 -0300
Subject: [PATCH] 0324 a01core: drop and autorun reports shown early in the
 next boot (held 15 s)

---
 bsd/dev/a01core_drop.c | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/bsd/dev/a01core_drop.c b/bsd/dev/a01core_drop.c
index 6dd9e4f..46feaf2 100644
--- a/bsd/dev/a01core_drop.c
+++ b/bsd/dev/a01core_drop.c
@@ -34,6 +34,7 @@
 extern vnode_t rootvnode;
 extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
+extern void IOSleep(unsigned milliseconds);
 extern vm_offset_t ml_static_ptovirt(vm_offset_t);
 void a01core_drop_apply(void);
 
@@ -219,11 +220,37 @@ adrop_install(void)
 		}
 	}
 	printf("A01CORE DROP: package %llu: %u entries written, %u failed\n", h.id, files, failed);
+	char note[128];
+	int n = snprintf(note, sizeof(note), "drop package %llu: %u entries written, %u failed\n", h.id, files, failed);
+	(void)adrop_file("/private/var/a01/drop.txt", 0644, (const uint8_t *)note, (uint64_t)n, ctx);
 	if (failed == 0) {
 		adrop_set_installed_id(h.id, ctx);
 	}
 }
 
+/*
+ * Results from the previous boot, on the console before the UI covers it: the drop's own
+ * report and the autorun's output (com.a01core.autorun writes /private/var/a01/autorun.txt).
+ */
+static int
+adrop_show(const char *path, vfs_context_t ctx)
+{
+	vnode_t vp = NULLVP;
+	char buf[1024];
+	int resid = 0;
+	if (vnode_open(path, FREAD, 0, 0, &vp, ctx) != 0) {
+		printf("A01CORE REPORT: %s: none yet\n", path);
+		return 0;
+	}
+	if (vn_rdwr(UIO_READ, vp, (caddr_t)buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx)) == 0) {
+		buf[sizeof(buf) - 1 - resid] = '\0';
+		printf("A01CORE REPORT: %s:\n%s\n", path, buf);
+	}
+	vnode_close(vp, FREAD, ctx);
+	return 1;
+}
+
 /* launchd remounts the root read-write itself: wait for it, then install */
 static void
 adrop_thread(__unused void *arg, __unused wait_result_t wr)
@@ -248,6 +275,17 @@ a01core_drop_apply(void)
 	unsigned int size;
 	thread_t thread;
 	PE_parse_boot_argn("a01drop", &on, sizeof(on));
+	/* The root is mounted (read-only) just before launchd: show last boot's results now, on
+	 * the boot thread, and hold them on screen before the UI covers the console. */
+	if (on && rootvnode != NULLVP) {
+		vfs_context_t ctx = vfs_context_kernel();
+		int shown = adrop_show("/private/var/a01/drop.txt", ctx);
+		shown += adrop_show("/private/var/a01/autorun.txt", ctx);
+		if (shown) {
+			printf("A01CORE REPORT: holding 15 s\n");
+			IOSleep(15000);
+		}
+	}
 	if (!on || SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
 	    SecureDTGetProperty(node, "A01Drop", (void const **)&reg, &size) != kSuccess || size < 16 ||
 	    reg[1] < ADROP_DATA) {
-- 
