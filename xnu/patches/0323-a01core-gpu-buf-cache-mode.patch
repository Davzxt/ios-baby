From 37f6f92f4a27915cc912f20b99c25051d3b6ee3f Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Mon, 2 Nov 2026 08:47:29 -0300
Subject: [PATCH] 0323 a01core: GPU buffers honour the DDK's CPU cache mode
 (uncached firmware-shared memory)

---
 iokit/Kernel/arm/A01CoreGPU.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/iokit/Kernel/arm/A01CoreGPU.cpp b/iokit/Kernel/arm/A01CoreGPU.cpp
index 4b4b3c1..d8e7711 100644
--- a/iokit/Kernel/arm/A01CoreGPU.cpp
+++ b/iokit/Kernel/arm/A01CoreGPU.cpp
@@ -41,7 +41,7 @@ struct a01gpu_buf {
 };
 
 extern "C" struct a01gpu_buf *
-a01gpu_buf_alloc(uint64_t size, int contiguous)
+a01gpu_buf_alloc(uint64_t size, int contiguous, int cache_mode)
 {
 	struct a01gpu_buf *b = IONewZero(struct a01gpu_buf, 1);
 	if (b == NULL) {
@@ -52,6 +52,13 @@ a01gpu_buf_alloc(uint64_t size, int contiguous)
 	if (contiguous) {
 		opts |= kIOMemoryPhysicallyContiguous;
 	}
+	/* the kernel mapping follows the DDK's CPU cache mode: memory the firmware writes (init
+	 * structures, CCBs, sync blocks) is uncached, or the CPU keeps reading stale lines */
+	if (cache_mode == 1) {
+		opts |= kIOMapInhibitCache;
+	} else if (cache_mode == 2) {
+		opts |= kIOMapWriteCombineCache;
+	}
 	/* GE8100: RGX_FEATURE_PHYS_BUS_WIDTH 32 */
 	b->md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, opts, b->size,
 	    0x00000000FFFFF000ULL);
