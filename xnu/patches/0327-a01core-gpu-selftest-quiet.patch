From d10d90df9bf98c95272cca9571af4976cd1b663d Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Mon, 2 Nov 2026 10:01:34 -0300
Subject: [PATCH] 0327 a01core: GPU self-test holds the screen only on failure
 (faster boot)

---
 iokit/Kernel/arm/A01CoreGPU.cpp | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/iokit/Kernel/arm/A01CoreGPU.cpp b/iokit/Kernel/arm/A01CoreGPU.cpp
index ab1da3b..4e3435b 100644
--- a/iokit/Kernel/arm/A01CoreGPU.cpp
+++ b/iokit/Kernel/arm/A01CoreGPU.cpp
@@ -134,8 +134,10 @@ a01pvr_selftest(void *arg, wait_result_t wr)
 	if (conn != NULL) {
 		a01pvr_close(conn);
 	}
-	IOLog("A01CORE PVR: self-test done; holding 15 s\n");
-	IOSleep(15000);   /* time to photograph the console */
+	if (e != 0) {
+		IOLog("A01CORE PVR: self-test FAILED; holding 15 s\n");
+		IOSleep(15000);   /* time to photograph the console */
+	}
 }
 
