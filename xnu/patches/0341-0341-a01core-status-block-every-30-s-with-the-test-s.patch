From d7a82d9fc2e2c32811e03bf93caedc0ba5c39917 Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Tue, 3 Nov 2026 12:35:18 -0300
Subject: [PATCH] 0341 a01core: status block every 30 s, with the test's GL1-7
 summary line

---
 bsd/dev/a01core_drop.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/bsd/dev/a01core_drop.c b/bsd/dev/a01core_drop.c
index 6d8967b..707f994 100644
--- a/bsd/dev/a01core_drop.c
+++ b/bsd/dev/a01core_drop.c
@@ -390,7 +390,7 @@ adrop_watch_thread(__unused void *arg, __unused wait_result_t wr)
 	vfs_context_t ctx = vfs_context_kernel();
 	char line[sizeof(adrop_watch_seen)];
 	char result = '-';
-	for (unsigned i = 0; i < 180; i++) {           /* every 5 s for 15 minutes */
+	for (unsigned i = 0; i < 360; i++) {           /* every 5 s for 30 minutes */
 		(void)tsleep((caddr_t)&adrop_watch_chan, PRIBIO, "a01watch", 5 * hz);
 		if (adrop_first_line("/private/var/herolte/autorun.out", line, sizeof(line), ctx) &&
 		    strcmp(line, adrop_watch_seen) != 0) {
@@ -425,7 +425,8 @@ adrop_watch_thread(__unused void *arg, __unused wait_result_t wr)
 		 * on screen, that can be typed back: 4 GPU letters (pvr_xnu_entry.c a01pvr_gpu_code) and the
 		 * test result (1 worked, 0 failed, P stopped/hung, - not yet).
 		 */
-		if ((i & 1) == 1) {
+		/* every 30 s (was 10 s: six lines each time pushed the test results off the screen) */
+		if (i % 6 == 5) {
 			char code[8];
 			char fault[48], fault2[48];
 			a01pvr_gpu_code(code);
@@ -446,6 +447,19 @@ adrop_watch_thread(__unused void *arg, __unused wait_result_t wr)
 				a01pvr_gpu_users(users, sizeof(users));
 				printf("A01 >>> GPU: %s <<<\n", users);
 			}
+			{
+				/* the test's GL summary, "GL 1234567" between quotes in its first line (+ ok, - wrong, ? running) */
+				const char *q = strnstr(adrop_watch_seen, "\"GL ", sizeof(adrop_watch_seen));
+				if (q != NULL) {
+					char gl[12];
+					strlcpy(gl, q + 4, sizeof(gl));
+					char *e = strnstr(gl, "\"", sizeof(gl));
+					if (e != NULL) {
+						*e = '\0';
+					}
+					printf("A01 >>> TESTES GL1-7: %s <<<\n", gl);
+				}
+			}
 			printf("A01 >>> CODIGO: %s-%c-%c%c%c%c <<<\n", code, result, adrop_fill_letter(),
 			    adrop_test_letter("TESTE 1 (copia de memoria): ", 'C'),
 			    adrop_test_letter("TESTE 2 (textura + render pass): ", 'R'),
-- 
2.55.0.windows.5

