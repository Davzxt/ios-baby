From f77d89925148ab9fffa20d536f4bbebc1f5ddc1b Mon Sep 17 00:00:00 2001
From: a01core <a01core@localhost>
Date: Sun, 1 Nov 2026 17:00:21 -0300
Subject: [PATCH] 0314 a01core: GPU test holds the screen 20 s

---
 bsd/dev/a01core_gpu.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/bsd/dev/a01core_gpu.c b/bsd/dev/a01core_gpu.c
index 49562c2..2e5887c 100644
--- a/bsd/dev/a01core_gpu.c
+++ b/bsd/dev/a01core_gpu.c
@@ -28,6 +28,8 @@
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void delay(int usec);
+static void hold(void) { printf("A01CORE GPU: holding the screen 20 s
+"); delay(20 * 1000 * 1000); }
 void a01core_gpu_probe(void);
 
 #define SPM_PA               0x10006000u
@@ -121,6 +123,7 @@ a01core_gpu_probe(void)
 	vm_offset_t mfgcfg = ml_io_map(MFG_CFG_PA, 0x1000);
 	if (!spm || !infra || !rgx || !mfgcfg) {
 		printf("A01CORE GPU: MMIO map failed\n");
+		hold();
 		return;
 	}
 	printf("A01CORE GPU: before: status %#x/%#x mfg_con %#x core0_con %#x protect_sta %#x\n",
@@ -132,11 +135,13 @@ a01core_gpu_probe(void)
 	if (e0 || e1) {
 		printf("A01CORE GPU: power-on failed (mfg %d, core0 %d): status %#x/%#x\n", e0, e1,
 		    rd(spm, SPM_PWR_STATUS), rd(spm, SPM_PWR_STATUS_2ND));
+		hold();
 		return;
 	}
 	wr(infra, INFRA_PROTECTEN_CLR, MFG_PROT_BITS);
 	if (wait_bits(infra, INFRA_PROTECTEN_STA1, MFG_PROT_BITS, 0)) {
 		printf("A01CORE GPU: bus protection did not release (sta1 %#x)\n", rd(infra, INFRA_PROTECTEN_STA1));
+		hold();
 		return;
 	}
 	wr(infra, INFRA_SI0_CTL, rd(infra, INFRA_SI0_CTL) & ~0x2u);
@@ -149,5 +154,6 @@ a01core_gpu_probe(void)
 	unsigned b = hi >> 16, v = hi & 0xffffu, n = lo >> 16, c = lo & 0xffffu;
 	printf("A01CORE GPU: core id %#x, BVNC %u.%u.%u.%u%s\n", rd(rgx, RGX_CORE_ID), b, v, n, c,
 	    (b == 22 && v == 49 && n == 21 && c == 16) ? " (GE8100) OK" : " (unexpected)");
+	hold();
 }
 #endif /* ARM64_BOARD_CONFIG_A01CORE */
-- 
