+/* ---- SPI0, FIFO mode with pause (CS stays asserted across 32-byte chunks) --- */
+static void
+spi_hw_setup(void)
+{
+	uint32_t div = (SPI_SRC_HZ + t_hz - 1) / t_hz;
+	if (div < 2) {
+		div = 2;
+	}
+	uint32_t sck = (div + 1) / 2, cs = sck * 2;
+	wr(g_spi, SPI_CFG2, ((sck - 1) & 0xffffu) | (((sck - 1) & 0xffffu) << 16));
+	wr(g_spi, SPI_CFG0, ((cs - 1) & 0xffffu) | (((cs - 1) & 0xffffu) << 16));
+	wr(g_spi, SPI_CFG1, (rd(g_spi, SPI_CFG1) & ~0xffu) | ((cs - 1) & 0xffu));
+	wr(g_spi, SPI_PAD_SEL, 0);
 }
 
