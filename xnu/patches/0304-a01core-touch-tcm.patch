+static int
+spi_xfer(const uint8_t *tx, uint8_t *rx, uint32_t len)
+{
+	int error = 0;
+	spi_begin();
+	for (uint32_t off = 0; off < len && !error; off += SPI_FIFO) {
+		uint32_t n = MIN(SPI_FIFO, len - off);
+		error = spi_chunk(tx ? tx + off : NULL, rx ? rx + off : NULL, n);
+	}
+	spi_end();
+	return error;
+}
+
+/* ---- TCM messages --------------------------------------------------------- */
+/* Reads one message. *code = status/report code, payload (up to msg_cap) in msg[]. */
+static int
+tcm_read(uint8_t *code, uint32_t *len)
+{
+	uint8_t hdr[4];
+	int error = spi_xfer(NULL, hdr, sizeof(hdr));
+	if (error) {
+		return error;
+	}
+	if (hdr[0] != MSG_MARKER) {
+		return ENXIO;
+	}
+	*code = hdr[1];
+	*len = 0;
+	if (hdr[1] == ST_IDLE || hdr[1] == ST_BUSY || hdr[1] == ST_CONTINUED || hdr[1] == ST_INVALID) {
+		return 0;
+	}
+	uint32_t plen = le16(&hdr[2]);
+	uint32_t remaining = plen + 1;               /* payload + padding byte */
+	uint32_t space = rd_chunk ? rd_chunk - 2 : remaining;
+	uint32_t got = 0;
+	uint8_t tmp[RD_CHUNK + 2];
+	while (remaining) {
+		uint32_t n = MIN(remaining, MIN(space, (uint32_t)sizeof(tmp) - 2));
+		if (n == 1) {                            /* only the padding byte is left */
+			remaining = 0;
+			break;
+		}
+		error = spi_xfer(NULL, tmp, n + 2);
+		if (error) {
+			return error;
+		}
+		if (tmp[0] != MSG_MARKER || tmp[1] != ST_CONTINUED) {
+			VLOG("continued read: bad header %02x %02x", tmp[0], tmp[1]);
+			return EIO;
+		}
+		for (uint32_t i = 0; i < n; i++, got++) {
+			if (got < plen && got < msg_cap) {
+				msg[got] = tmp[2 + i];
+			} else if (got == plen && tmp[2 + i] != MSG_PADDING) {
+				VLOG("bad padding %02x", tmp[2 + i]);
+			}
+		}
+		remaining -= n;
+	}
+	*len = MIN(plen, msg_cap);
+	return 0;
+}
+
+/* Sends [cmd, len, payload] in chunks; chunk 0 = one transaction (host download). */
+static int
+tcm_send(uint8_t cmd, const uint8_t *payload, uint32_t len, uint32_t chunk)
+{
+	uint32_t total = len + 2;                    /* the two length bytes count as payload */
+	uint32_t space = chunk ? chunk - 1 : total;
+	uint8_t *buf = kalloc_data(MIN(total, space) + 1, Z_WAITOK);
+	if (!buf) {
+		return ENOMEM;
+	}
+	int error = 0;
+	for (uint32_t off = 0; off < total && !error; off += space) {
+		uint32_t n = MIN(space, total - off);
+		buf[0] = off ? CMD_CONTINUE_WRITE : cmd;
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t p = off + i;
+			buf[1 + i] = p == 0 ? (uint8_t)len : p == 1 ? (uint8_t)(len >> 8) : payload[p - 2];
+		}
+		error = spi_xfer(buf, NULL, n + 1);
+		if (off + n < total) {
+			delay(800);
+		}
+	}
+	kfree_data(buf, MIN(total, space) + 1);
+	return error;
+}
