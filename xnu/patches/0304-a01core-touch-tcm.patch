+/* Command and response. Reports that arrive meanwhile go to handle_report(). */
+static int
+tcm_command(uint8_t cmd, const uint8_t *payload, uint32_t len, uint32_t chunk, uint32_t *resp_len)
+{
+	int error = tcm_send(cmd, payload, len, chunk);
+	if (error) {
+		LOG("command %#x: send failed (%d)", cmd, error);
+		return error;
+	}
+	for (uint32_t waited = 0; waited < RESP_TIMEOUT_MS; ) {
+		if (!attention() && (waited % 50u) != 0) {
+			t_msleep(2);
+			waited += 2;
+			continue;
+		}
+		uint8_t code;
+		uint32_t n;
+		error = tcm_read(&code, &n);
+		if (error == 0 && code >= RPT_IDENTIFY) {
+			handle_report(code, n);
+			continue;
+		}
+		if (error == 0 && code == ST_OK) {
+			if (resp_len) {
+				*resp_len = n;
+			}
+			return 0;
+		}
+		if (error == 0 && code != ST_IDLE && code != ST_BUSY && code != ST_INVALID) {
+			LOG("command %#x: status %#x", cmd, code);
+			return EIO;
+		}
+		t_msleep(2);
+		waited += 2;
+	}
+	LOG("command %#x: no response", cmd);
+	return ETIMEDOUT;
+}
+
+/* ---- firmware image -------------------------------------------------------- */
+static int
+fw_find(void)
+{
+	DTEntry node;
+	const uint64_t *reg;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "TouchFirmware", (void const **)&reg, &size) != kSuccess ||
+	    size < 16 || reg[1] < 8) {
+		LOG("no touch firmware in the payload (mkpayload.py --blob TouchFirmware=td4150_a01core.img)");
+		return ENOENT;
+	}
+	const uint8_t *img = (const uint8_t *)ml_static_ptovirt((vm_offset_t)reg[0]);
+	uint64_t img_len = reg[1];
+	if (!img || le32(img) != IMG_MAGIC) {
+		LOG("touch firmware at %#llx: bad magic", reg[0]);
+		return EINVAL;
+	}
+	uint32_t areas = le32(img + 4);
+	for (uint32_t i = 0; i < areas && 8 + 4 * i + 4 <= img_len; i++) {
+		uint32_t at = le32(img + 8 + 4 * i);
+		if ((uint64_t)at + 36 > img_len || le32(img + at) != AREA_MAGIC) {
+			continue;
+		}
+		const char *id = (const char *)(img + at + 4);
+		uint32_t len = le32(img + at + 28), crc = le32(img + at + 32);
+		const uint8_t *data = img + at + 36;
+		if ((uint64_t)at + 36 + len > img_len || crc32_ieee(data, len) != crc) {
+			LOG("touch firmware area %u: bad length or checksum", i);
+			continue;
+		}
+		struct area *dst = !strncmp(id, "ROMBOOT_APP_CODE", 16) ? &fw_app :
+		    !strncmp(id, "APP_CONFIG", 10) ? &fw_appcfg :
+		    !strncmp(id, "DISPLAY", 7) ? &fw_disp : NULL;
+		if (dst) {
+			dst->data = data;
+			dst->len = len;
+		}
+	}
+	LOG("firmware: app %u, app config %u, display config %u bytes", fw_app.len, fw_appcfg.len, fw_disp.len);
+	return fw_app.len && fw_appcfg.len ? 0 : EINVAL;
+}
+
+/* ---- bring-up --------------------------------------------------------------- */
+enum { S_DETECT, S_ROMBOOT, S_WAIT_STATUS, S_APP, S_RUN } t_state;
+static uint16_t fw_status;
+static uint8_t id_mode;
+
+static void
+take_identify(uint32_t len)
+{
+	if (len < 24) {
+		return;
+	}
+	id_mode = msg[1];
+	uint32_t max_write = le16(&msg[22]);
+	wr_chunk = max_write ? MIN(max_write, WR_CHUNK_MAX) : WR_CHUNK_MAX;
+	rd_chunk = id_mode == MODE_ROMBOOT ? 0 : RD_CHUNK;
+	LOG("identify: version %u mode %#x part %.16s build %u max write %u",
+	    msg[0], id_mode, (const char *)&msg[2], le32(&msg[18]), max_write);
+}
+
+static int
+download_config(int type)
+{
+	const struct area *a = type == 1 ? &fw_appcfg : &fw_disp;
+	if (!a->len) {
+		LOG("firmware asks for config type %d that the image does not have", type);
+		return ENOENT;
+	}
+	uint32_t pad = type == 1 ? (8u - a->len % 8u) % 8u : 0;
+	uint32_t n = a->len + 2 + pad;
+	uint8_t *p = kalloc_data(n, Z_WAITOK | Z_ZERO);
+	if (!p) {
+		return ENOMEM;
+	}
+	uint32_t hdl_version = (fw_status >> 3) & 0xfu;
+	p[0] = hdl_version == 2 ? 2 : 1;
+	p[1] = (uint8_t)type;
+	memcpy(p + 2, a->data, a->len);
+	uint32_t rlen = 0;
+	int error = tcm_command(CMD_DOWNLOAD_CONFIG, p, n, wr_chunk, &rlen);
+	kfree_data(p, n);
+	if (!error && rlen >= 2) {
+		fw_status = (uint16_t)le16(msg);
+	}
+	LOG("config type %d (%u bytes): %d, status now %#x", type, a->len, error, fw_status);
+	return error;
+}
+
+static void
+handle_status(void)
+{
+	/* bit1 need display config, bit2 need app config, bits 3..6 HDL version */
+	for (int round = 0; round < 6 && (fw_status & 0x6u); round++) {
+		int error = (fw_status & 0x4u) ? download_config(1) : download_config(2);
+		if (error) {
+			return;
+		}
+	}
+	if (!(fw_status & 0x6u) && t_state < S_APP) {
+		t_state = S_APP;
+	}
+}
+
+static void
+report_touch(uint32_t len)
+{
+	uint16_t down = 0;
+	for (uint32_t o = 0; o + OBJ_BYTES <= len; o += OBJ_BYTES) {
+		uint32_t idx = msg[o], cls = msg[o + 1];
+		int x = (int)le16(&msg[o + 2]), y = (int)le16(&msg[o + 4]);
+		if (idx >= MAX_FINGERS || (cls != 1 && cls != 2)) {   /* finger / glove */
+			continue;
+		}
+		if (t_swap) {
+			int t = x; x = y; y = t;
+		}
+		x = x * PANEL_W / (max_x + 1);
+		y = y * PANEL_H / (max_y + 1);
+		if (t_flipx) {
+			x = PANEL_W - 1 - x;
+		}
+		if (t_flipy) {
+			y = PANEL_H - 1 - y;
+		}
+		x = MAX(0, MIN(PANEL_W - 1, x));
+		y = MAX(0, MIN(PANEL_H - 1, y));
+		down |= (uint16_t)(1u << idx);
+		last_x[idx] = (int16_t)x;
+		last_y[idx] = (int16_t)y;
+		sweet_hid_touch((int)idx, 1, x, y);
+	}
+	uint16_t lifted = down_mask_prev & (uint16_t)~down;
+	for (uint32_t i = 0; i < MAX_FINGERS; i++) {
+		if (lifted & (1u << i)) {
+			sweet_hid_touch((int)i, 0, last_x[i], last_y[i]);
+		}
+	}
+	down_mask_prev = down;
+}
+
+static void
+handle_report(uint8_t code, uint32_t len)
+{
+	switch (code) {
+	case RPT_IDENTIFY:
+		take_identify(len);
+		if (id_mode == MODE_ROMBOOT) {
+			t_state = S_ROMBOOT;
+		} else if (t_state == S_RUN) {
+			LOG("touch controller reset itself; reconfiguring");
+			t_state = S_APP;
+		}
+		break;
+	case RPT_STATUS:
+		if (len >= 2) {
+			fw_status = (uint16_t)le16(msg);
+			VLOG("status report %#x", fw_status);
+			if (t_state < S_RUN) {
+				t_state = S_WAIT_STATUS;
+			}
+		}
+		break;
+	case RPT_TOUCH:
+		if (t_state == S_RUN) {
+			report_touch(len);
+		}
+		break;
+	default:
+		VLOG("report %#x (%u bytes) ignored", code, len);
+		break;
+	}
+}
+
+static int
+romboot_download(void)
+{
+	uint32_t n = ROMBOOT_RESERVED + fw_app.len;
+	uint8_t *p = kalloc_data(n, Z_WAITOK | Z_ZERO);
+	if (!p) {
+		return ENOMEM;
+	}
+	p[0] = (uint8_t)(fw_app.len >> 16);
+	memcpy(p + ROMBOOT_RESERVED, fw_app.data, fw_app.len);
+	LOG("sending %u bytes of firmware", fw_app.len);
+	int error = tcm_command(CMD_ROMBOOT_DOWNLOAD, p, n, 0, NULL);
+	kfree_data(p, n);
+	if (!error) {
+		error = tcm_command(CMD_ROMBOOT_RUN_BL, NULL, 0, 0, NULL);
+	}
+	LOG("host download %s (%d)", error ? "FAILED" : "done", error);
+	t_state = S_WAIT_STATUS;
+	return error;
+}
+
+static int
+app_setup(void)
+{
+	uint32_t n = 0;
+	int error = tcm_command(CMD_GET_APP_INFO, NULL, 0, wr_chunk, &n);
+	if (error || n < 40) {
+		LOG("application info failed (%d, %u bytes)", error, n);
+		return error ? error : EIO;
+	}
+	uint32_t status = le16(&msg[2]);
+	cfg_size = (uint16_t)le16(&msg[12]);
+	max_x = (uint16_t)le16(&msg[32]);
+	max_y = (uint16_t)le16(&msg[34]);
+	if (!max_x || !max_y) {
+		max_x = PANEL_W - 1;
+		max_y = PANEL_H - 1;
+	}
+	LOG("application: status %u, max x %u, max y %u, objects %u, report config size %u",
+	    status, max_x, max_y, le16(&msg[36]), cfg_size);
+	static const uint8_t layout[] = {
+		TOUCH_FOREACH_ACTIVE,
+		TOUCH_OBJ_INDEX, 8, TOUCH_OBJ_CLASS, 8, TOUCH_OBJ_X, 16, TOUCH_OBJ_Y, 16,
+		TOUCH_FOREACH_END, TOUCH_END,
+	};
+	uint32_t len = MAX((uint32_t)cfg_size, (uint32_t)sizeof(layout));
+	uint8_t *cfg = kalloc_data(len, Z_WAITOK | Z_ZERO);
+	if (!cfg) {
+		return ENOMEM;
+	}
+	memcpy(cfg, layout, sizeof(layout));
+	error = tcm_command(CMD_SET_TOUCH_CFG, cfg, len, wr_chunk, NULL);
+	kfree_data(cfg, len);
+	LOG("touch report layout: %d", error);
+	if (!error) {
+		down_mask_prev = 0;
+		t_state = S_RUN;
+	}
+	return error;
+}
+
+static void
+touch_thread(__unused void *arg, __unused wait_result_t wres)
+{
+	int failures = 0;
+	t_msleep(1500);
+	msg = kalloc_data(msg_cap, Z_WAITOK | Z_ZERO);
+	if (!msg || fw_find() != 0) {
+		LOG("touch disabled");
+		return;
+	}
+	t_state = S_DETECT;
+	for (;;) {
+		if (failures > 8) {
+			LOG("giving up after repeated failures (boot-arg a01touch=2 for details)");
+			return;
+		}
+		switch (t_state) {
+		case S_DETECT: {
+			uint8_t code;
+			uint32_t n;
+			int error = tcm_read(&code, &n);
+			if (error == ENXIO) {
+				LOG("no TouchComm device on SPI0 CS0 (panel variant NT36525B is not supported, "
+				    "or SPI not working)");
+				failures += 3;
+				t_msleep(500);
+				break;
+			}
+			if (!error && code == RPT_IDENTIFY) {
+				take_identify(n);
+				t_state = id_mode == MODE_ROMBOOT ? S_ROMBOOT : S_APP;
+			} else if (!error && code >= RPT_IDENTIFY) {
+				handle_report(code, n);
+			} else if (!error && code == ST_IDLE) {
+				/* nothing pending: ask who it is */
+				(void)tcm_command(CMD_IDENTIFY, NULL, 0, wr_chunk, &n);
+				if (n >= 24) {
+					take_identify(n);
+					t_state = id_mode == MODE_ROMBOOT ? S_ROMBOOT : S_APP;
+				} else {
+					failures++;
+					t_msleep(100);
+				}
+			} else {
+				failures++;
+				t_msleep(100);
+			}
+			break;
+		}
+		case S_ROMBOOT:
+			if (romboot_download() != 0) {
+				failures++;
+				t_state = S_DETECT;
+				t_msleep(200);
+			}
+			break;
+		case S_WAIT_STATUS: {
+			/* the host-download firmware boots, identifies, then asks for configs */
+			uint32_t waited = 0;
+			while (t_state == S_WAIT_STATUS && waited < 2000) {
+				uint8_t code;
+				uint32_t n;
+				if (attention() && tcm_read(&code, &n) == 0 && code >= RPT_IDENTIFY) {
+					handle_report(code, n);
+					if (code == RPT_STATUS) {
+						handle_status();
+					}
+				} else {
+					t_msleep(5);
+					waited += 5;
+				}
+			}
+			if (t_state == S_WAIT_STATUS) {
+				if (fw_status & 0x6u) {
+					handle_status();
+				} else if (id_mode == MODE_APP || id_mode == MODE_HOSTDOWNLOAD) {
+					t_state = S_APP;
+				} else {
+					failures++;
+					t_state = S_DETECT;
+				}
+			}
+			break;
+		}
+		case S_APP:
+			if (app_setup() != 0) {
+				failures++;
+				t_state = S_DETECT;
+				t_msleep(200);
+			} else {
+				LOG("ready");
+				failures = 0;
+			}
+			break;
+		case S_RUN: {
+			uint8_t code;
+			uint32_t n;
+			if (!attention()) {
+				t_msleep(4);
+				break;
+			}
+			int error = tcm_read(&code, &n);
+			if (error) {
+				VLOG("read error %d", error);
+				t_msleep(10);
+				break;
+			}
+			if (code >= RPT_IDENTIFY) {
+				handle_report(code, n);
+				if (code == RPT_STATUS && (fw_status & 0x6u)) {
+					handle_status();
+				}
+			}
+			break;
+		}
+		}
+	}
+}
+
+static void
+pins_and_clock(void)
+{
+	for (unsigned i = 0; i < 4; i++) {
+		unsigned pin = spi_pins[i];
+		uint32_t v = rd(g_gpio, GPIO_MODE(pin));
+		v = (v & ~(0xfu << GPIO_MODE_SHIFT(pin))) | (1u << GPIO_MODE_SHIFT(pin));
+		wr(g_gpio, GPIO_MODE(pin), v);
+	}
+	uint32_t m = rd(g_gpio, GPIO_MODE(TS_ATTN_GPIO));
+	wr(g_gpio, GPIO_MODE(TS_ATTN_GPIO), m & ~(0xfu << GPIO_MODE_SHIFT(TS_ATTN_GPIO)));
+	wr(g_gpio, GPIO_DIR(TS_ATTN_GPIO), rd(g_gpio, GPIO_DIR(TS_ATTN_GPIO)) & ~(1u << (TS_ATTN_GPIO % 32u)));
+	wr(g_infra, INFRA_CG1_CLR, INFRA_CG1_SPI0);
+	delay(20);
+}
