+static uint32_t
+crc32_ieee(const uint8_t *p, uint32_t n)
+{
+	uint32_t c = 0xffffffffu;
+	while (n--) {
+		c ^= *p++;
+		for (int k = 0; k < 8; k++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+		}
+	}
+	return ~c;
+}
